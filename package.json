{
  "name": "avro-bangla-suggestions",
  "private": false,
  "description": "A React hook for Avro phonetics-based Bangla typing suggestions — works in React and Next.js projects",
  "author": "Hasnat Shohag <hasnat.ru.ice19@gmail.com>",
  "license": "MIT",
  "keywords": [
    "avro",
    "bangla",
    "suggestion",
    "suggestions",
    "bangla suggestions",
    "phonetics",
    "avro phonetics",
    "avro integration",
    "avro bangla integration",
    "avro bangla suggestions",
    "avro phonetics integration",
    "avro phonetics suggestions integration"
  ],
  "version": "0.0.3",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist/index.es.js",
    "dist/index.umd.js",
    "dist/index.d.ts",
    "dist/avro",
    "dist/avro.min-*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^3.9.1"
  }
}
